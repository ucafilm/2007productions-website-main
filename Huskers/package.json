{
  "name": "nebraska-huskers-game-sheet",
  "version": "1.0.0",
  "description": "Advanced Game Sheet Generator for Nebraska Cornhuskers Football",
  "main": "index.js",
  "scripts": {
    "build-css": "tailwindcss -i ./src/input.css -o ./assets/css/tailwind.css --watch",
    "build-css-prod": "tailwindcss -i ./src/input.css -o ./assets/css/tailwind.css --minify",
    "dev": "npm run build-css",
    "build": "npm run build-css-prod"
  },
  "keywords": [
    "nebraska",
    "huskers",
    "football",
    "game-sheet",
    "sports-analytics"
  ],
  "author": "2007 Productions",
  "license": "MIT",
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
